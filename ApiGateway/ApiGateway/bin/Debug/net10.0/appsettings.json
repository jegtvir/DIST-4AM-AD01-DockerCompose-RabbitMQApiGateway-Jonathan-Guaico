{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "seguridad-route": {
        "ClusterId": "seguridad-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "categoria-route": {
        "ClusterId": "categoria-cluster",
        "Match": {
          "Path": "/api/categoria/{**catch-all}"
        }
      },
      "vehiculo-route": {
        "ClusterId": "vehiculo-cluster",
        "Match": {
          "Path": "/api/vehiculo/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "seguridad-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://seguridad-api:8080"
          }
        }
      },
      "categoria-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://categoria-api:8080"
          }
        }
      },
      "vehiculo-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://vehiculo-api:8080"
          }
        }
      }
    }
  }
}
