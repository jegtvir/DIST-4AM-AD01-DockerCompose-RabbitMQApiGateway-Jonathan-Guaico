{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "seguridad-route": {
        "ClusterId": "seguridad-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "categoria-route": {
        "ClusterId": "categoria-cluster",
        "Match": {
          "Path": "/api/categoria/{**catch-all}"
        }
      },
      "vehiculo-route": {
        "ClusterId": "vehiculo-cluster",
        "Match": {
          "Path": "/api/vehiculo/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "seguridad-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5260"
          }
        }
      },
      "categoria-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5259"
          }
        }
      },
      "vehiculo-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5258"
          }
        }
      }
    }
  }
}
